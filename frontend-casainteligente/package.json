{
  "name": "frontend-casainteligente",
  "version": "1.0.1",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "electron-vite build",
    "build": "electron-builder",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.casainteligente.app",
    "productName": "Casa Inteligente",
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "freertos/",
        "to": "freertos/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.5",
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "framer-motion": "^12.23.24",
    "globals": "^16.4.0",
    "lucide-react": "^0.553.0",
    "postcss": "^8.5.6",
    "server": "^1.0.42",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}